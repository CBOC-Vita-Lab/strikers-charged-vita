From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: CBOC-Vita <cboc-vita@users.noreply.github.com>
Date: Fri, 13 Nov 2026 22:00:00 -0500
Subject: [PATCH] patcher and render target create timers (vglPatchTimingTake)

---

diff --git a/source/gxm.c b/source/gxm.c
index 9b2d2543..73d82a73 100644
--- a/source/gxm.c
+++ b/source/gxm.c
@@ -74,6 +74,20 @@ static framebuffer *scene_fail_fb = NULL;
 static uint32_t scene_fail_frame = 0;
 static uint32_t vgl_scene_failures = 0;
 uint32_t vgl_shader_patch_failures = 0; // shared.h patch_vertex_program / patch_fragment_program
+uint32_t vgl_patch_calls[3] = {0, 0, 0};
+uint64_t vgl_patch_us[3] = {0, 0, 0};
+uint32_t vgl_patch_max_us[3] = {0, 0, 0};
+// 1.3 wave 10 (0035): the counts, total and longest microseconds of the patcher's vertex and fragment program creates and of sceGxmCreateRenderTarget since the last call (all three arrays of 3), then reset.
+void vglPatchTimingTake(uint32_t *calls, uint64_t *us, uint32_t *max_us) {
+	for (int i = 0; i < 3; i++) {
+		calls[i] = vgl_patch_calls[i];
+		us[i] = vgl_patch_us[i];
+		max_us[i] = vgl_patch_max_us[i];
+		vgl_patch_calls[i] = 0;
+		vgl_patch_us[i] = 0;
+		vgl_patch_max_us[i] = 0;
+	}
+}
 void vglSetRobustScenes(uint32_t enabled) { vgl_robust_scenes = enabled ? GL_TRUE : GL_FALSE; }
 uint32_t vglRobustFailures(uint32_t *scene_begins, uint32_t *shader_patches) {
 	if (scene_begins)
@@ -350,7 +364,10 @@ static inline __attribute__((always_inline)) int setup_render_target_ms(SceGxmRe
 	renderTargetParams.scenesPerFrame = refs;
 	renderTargetParams.multisampleMode = mode;
 	renderTargetParams.driverMemBlock = -1;
-	return sceGxmCreateRenderTarget(&renderTargetParams, rt);
+	uint64_t t0 = sceKernelGetProcessTimeWide();
+	int r = sceGxmCreateRenderTarget(&renderTargetParams, rt);
+	vgl_patch_note(2, t0);
+	return r;
 }
 
 static inline __attribute__((always_inline)) int setup_render_target(SceGxmRenderTarget **rt, int w, int h, int refs) {
diff --git a/source/shared.h b/source/shared.h
index 12aca619..d7adb9ee 100644
--- a/source/shared.h
+++ b/source/shared.h
@@ -487,8 +487,22 @@ extern size_t max_fcache_size;
 // 1.2: both return the sceGxm result (0 = made); a program that was not made is not published by the callers that check it (custom_shaders.c)
 extern GLboolean vgl_robust_scenes; // gxm.c vglSetRobustScenes: the 1.2 failure handling (scene entry, shader patching) is on
 extern uint32_t vgl_shader_patch_failures;
+// 1.3 wave 10 (0035): the patcher's and the render target's own cost, microseconds in sceKernelGetProcessTimeWide: [0] vertex program creates, [1] fragment program creates, [2] render target creates; read and reset by vglPatchTimingTake
+extern uint32_t vgl_patch_calls[3];
+extern uint64_t vgl_patch_us[3];
+extern uint32_t vgl_patch_max_us[3];
+#include <psp2/kernel/processmgr.h>
+static inline __attribute__((always_inline)) void vgl_patch_note(int k, uint64_t t0) {
+	uint64_t d = sceKernelGetProcessTimeWide() - t0;
+	vgl_patch_calls[k]++;
+	vgl_patch_us[k] += d;
+	if (d > vgl_patch_max_us[k])
+		vgl_patch_max_us[k] = (uint32_t)d;
+}
 static inline __attribute__((always_inline)) int patch_vertex_program(SceGxmShaderPatcherId id, const SceGxmVertexAttribute *attr, uint32_t attr_num, const SceGxmVertexStream *stream, uint32_t stream_num, SceGxmVertexProgram **prog) {
+	uint64_t t0 = sceKernelGetProcessTimeWide();
 	int r = vglCreateVertexProgram(id, attr, attr_num, stream, stream_num, prog);
+	vgl_patch_note(0, t0);
 	if (r) {
 		vgl_shader_patch_failures++;
 #ifdef LOG_ERRORS
@@ -498,7 +512,9 @@ static inline __attribute__((always_inline)) int patch_vertex_program(SceGxmShad
 	return r;
 }
 static inline __attribute__((always_inline)) int patch_fragment_program(SceGxmShaderPatcherId id, SceGxmOutputRegisterFormat fmt, SceGxmMultisampleMode msaa_mode, const SceGxmBlendInfo *blend_cfg, const SceGxmProgram *vertex_link, SceGxmFragmentProgram **prog) {
+	uint64_t t0 = sceKernelGetProcessTimeWide();
 	int r = sceGxmShaderPatcherCreateFragmentProgram(gxm_shader_patcher, id, fmt, msaa_mode, blend_cfg, vertex_link, prog);
+	vgl_patch_note(1, t0);
 	if (r) {
 		vgl_shader_patch_failures++;
 #ifdef LOG_ERRORS
diff --git a/source/vitaGL.h b/source/vitaGL.h
index f3a075a8..5a4030f5 100644
--- a/source/vitaGL.h
+++ b/source/vitaGL.h
@@ -1526,6 +1526,7 @@ uint32_t vglRtRingDrops(void);            // scenes that were submitted without
 // open scene and makes the draw, clear or blit that asked skip itself; the same framebuffer is tried again in the next frame at the earliest.
 void vglSetRobustScenes(uint32_t enabled); // default 1; 0 = the 1.1 behaviour (before any drawing)
 uint32_t vglRobustFailures(uint32_t *scene_begins, uint32_t *shader_patches); // scene entries refused / shader programs not made, so far (returns their sum)
+void vglPatchTimingTake(uint32_t *calls, uint64_t *us, uint32_t *max_us); // 1.3 wave 10 (0035): patcher vertex / fragment program creates and render target creates since the last call (3 entries each: counts, microseconds, longest), then reset
 void vglRtSceneProgress(uint32_t *submitted, uint32_t *done); // scenes ended / seen completed by the GPU watcher (GPU timers on; else 0 / 0)
 int vglRtWaitScenesDone(uint32_t target, uint32_t timeout_us); // 0022: blocks until done reaches target (0), timeout (1), or -1: poll vglRtSceneProgress instead
 void vglSetAnisotropicFilter(uint32_t sceFilter); // 0 off; 2 or 3: the minification filter of trilinear textures (see utils/gxm_utils.h) // the newest finished GPU frame; returns frames finished so far (0: none)
