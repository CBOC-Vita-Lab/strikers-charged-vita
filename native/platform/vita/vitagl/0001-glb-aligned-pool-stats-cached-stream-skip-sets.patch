+	if (to <= from)
+		return;
+	stream_flushed[vgl_circular_idx] = to;
+	stream_flushes++;
+	stream_flushed_bytes += to - from;
+	if (stream_flush_fn)
+		stream_flush_fn(from, to - from);
+	else
+		sceKernelSyncVMDomain(stream_uid, from, to - from);
