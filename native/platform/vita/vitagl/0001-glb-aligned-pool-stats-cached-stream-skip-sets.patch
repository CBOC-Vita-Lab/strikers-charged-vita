+	SceKernelMemBlockType type = stream_mem == 1 ? SCE_KERNEL_MEMBLOCK_TYPE_USER_CDRAM_RW : (stream_mem == 2 ? SCE_KERNEL_MEMBLOCK_TYPE_USER_RW_UNCACHE : SCE_KERNEL_MEMBLOCK_TYPE_USER_RW);
