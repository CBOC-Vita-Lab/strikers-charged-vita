From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: CBOC-Vita <cboc-vita@users.noreply.github.com>
Date: Fri, 30 Oct 2026 08:41:25 -0400
Subject: [PATCH] Anisotropic minification, framebuffer depth binding, GPU frame progress
 binding, GPU frame progress queries

---
 source/framebuffers.c    | 21 +++++++++++++++++++++
 source/rt.c              | 20 ++++++++++++++++++++
 source/utils/gxm_utils.h | 13 +++++++++++++
 source/vitaGL.h          |  4 ++++
 4 files changed, 58 insertions(+)

diff --git a/source/framebuffers.c b/source/framebuffers.c
index e7a4f2f..56ccd51 100644
--- a/source/framebuffers.c
+++ b/source/framebuffers.c
@@ -955,6 +955,27 @@ void vglTexImageDepthBuffer(GLenum target) {
 	}
 }
 
+/* Strikers 1.1: the depth buffer of framebuffer `fb` (a glGenFramebuffers name) as the texture bound to the active unit, for a shader
+ * that reads the scene's depth (vitaGL has no depth textures and attaches colour only). The surface is LINEAR DF32M with rows of
+ * VGL_ALIGN(width, SCE_GXM_TILE_SIZEX) samples; the texture is that wide, so a caller maps u to [0, width / returned value].
+ * Returns the row width in samples, or 0 when the framebuffer has no depth buffer yet (before its first scene). The texture only
+ * points at the surface: it is rebound before every use (the surface moves when the framebuffer is resized) and owns no memory. */
+int vglStrikersBindFramebufferDepth(GLuint fb_id) {
+	framebuffer *fb = (framebuffer *)fb_id;
+	if (!fb || !fb->active || !fb->depthbuffer_ptr || !(fb->depthbuffer_state & DEPTHBUFFER_READY) || !fb->depthbuffer_ptr->depthData)
+		return 0;
+	texture_unit *tex_unit = &texture_units[server_texture_unit];
+	texture *tex = &texture_slots[tex_unit->tex_id[0]];
+	if (tex->data)
+		return 0; // (a texture with storage of its own is never repointed)
+	const int row = VGL_ALIGN(fb->width, SCE_GXM_TILE_SIZEX);
+	// (no store-mode change here: it would alter a surface whose scene may still be open; the caller's scene hints store the depth)
+	if (sceGxmTextureInitLinear(&tex->gxm_tex, fb->depthbuffer_ptr->depthData, SCE_GXM_TEXTURE_FORMAT_DF32M, row, fb->height, 0) < 0)
+		return 0;
+	tex->status = TEX_VALID;
+	return row;
+}
+
 GLboolean glIsFramebuffer(GLuint fb) {
 	framebuffer *p = (framebuffer *)fb;
 	return (p && p->active);
diff --git a/source/rt.c b/source/rt.c
index 99d8d39..8685034 100644
--- a/source/rt.c
+++ b/source/rt.c
@@ -29,6 +29,8 @@
 #include "shared.h"
 
 uint32_t vgl_rt_flags = 0;
+uint32_t vgl_aniso_min = 0; // utils/gxm_utils.h vglSetTexMinFilter
+void vglSetAnisotropicFilter(uint32_t sceFilter) { vgl_aniso_min = (sceFilter == 2 || sceFilter == 3) ? sceFilter : 0; }
 GLuint vgl_rt_hint_fb = 0;
 uint32_t vgl_rt_hint = 0;
 GLboolean vgl_rt_hint_valid = GL_FALSE;
@@ -280,6 +282,24 @@ void vglRtSetup(uint32_t flags, int watcher_priority, int watcher_affinity) {
 	}
 }
 
+// Scenes ended so far and scenes the GPU watcher has seen completed (VGL_RT_GPU_TIMERS): a frame whose last scene was number n is finished on
+// the GPU when done >= n (the Strikers port's adaptive queue depth waits for that). 0 / 0 without the timers.
+void vglRtSceneProgress(uint32_t *submitted, uint32_t *done) {
+	*submitted = rt_slots ? rt_produced : 0;
+	*done = rt_slots ? rt_consumed : 0;
+}
+
+// The newest frame the GPU watcher has finished (VGL_RT_GPU_TIMERS): 0 when there is none yet, else the count of frames finished so far
+// (the caller sees a new frame when it grows). Cheap: one record, no copy of the rings (the renderer's resolution governor reads it per frame).
+uint32_t vglRtLastGpuFrame(vglRtGpuFrame *out) {
+	const uint32_t h = rt_gpu_frame_head;
+	if (!h)
+		return 0;
+	__sync_synchronize();
+	*out = rt_gpu_frames[(h - 1) % RT_FRAMES];
+	return h;
+}
+
 void vglRtGetStats(vglRtStats *s) {
 	s->version = 1;
 	s->flags = vgl_rt_flags;
diff --git a/source/utils/gxm_utils.h b/source/utils/gxm_utils.h
index e297278..c2d2756 100644
--- a/source/utils/gxm_utils.h
+++ b/source/utils/gxm_utils.h
@@ -108,8 +108,14 @@ static inline __attribute__((always_inline)) void vglSetTexVMode(SceGxmTexture *
 	SceGxmTextureInternal *tex = (SceGxmTextureInternal *)texture;
 	tex->control_words[0] = ((addrMode << 3) & 0x38) | tex->control_words[0] & 0xFFFFFFC7;
 }
+// (Strikers port, 23 Oct) vglSetAnisotropicFilter: a trilinear texture (minification LINEAR with the mip filter on) is given this
+// minification filter instead (2 or 3: the filter values vitasdk names MIPMAP_LINEAR / MIPMAP_POINT, believed to be the hardware's
+// anisotropic modes; 0: off, the default)
+extern uint32_t vgl_aniso_min;
 static inline __attribute__((always_inline)) void vglSetTexMinFilter(SceGxmTexture *texture, SceGxmTextureFilter minFilter) {
 	SceGxmTextureInternal *tex = (SceGxmTextureInternal *)texture;
+	if (vgl_aniso_min && minFilter == SCE_GXM_TEXTURE_FILTER_LINEAR && (tex->control_words[0] & 0x200))
+		minFilter = (SceGxmTextureFilter)vgl_aniso_min;
 	tex->control_words[0] = ((minFilter << 10) & 0xC00) | tex->control_words[0] & 0xFFFFF3FF;
 }
 static inline __attribute__((always_inline)) void vglSetTexMagFilter(SceGxmTexture *texture, SceGxmTextureFilter magFilter) {
@@ -119,6 +125,13 @@ static inline __attribute__((always_inline)) void vglSetTexMagFilter(SceGxmTextu
 static inline __attribute__((always_inline)) void vglSetTexMipFilter(SceGxmTexture *texture, SceGxmTextureMipFilter mipFilter) {
 	SceGxmTextureInternal *tex = (SceGxmTextureInternal *)texture;
 	tex->control_words[0] = mipFilter & 0x200 | tex->control_words[0] & 0xFFFFFDFF;
+	if (vgl_aniso_min) { // (the order of the two calls varies: a LINEAR minification becomes anisotropic once the mip filter is on, and back)
+		const uint32_t minf = (tex->control_words[0] >> 10) & 3;
+		if ((mipFilter & 0x200) && minf == SCE_GXM_TEXTURE_FILTER_LINEAR)
+			tex->control_words[0] = ((vgl_aniso_min << 10) & 0xC00) | tex->control_words[0] & 0xFFFFF3FF;
+		else if (!(mipFilter & 0x200) && minf == vgl_aniso_min)
+			tex->control_words[0] = ((SCE_GXM_TEXTURE_FILTER_LINEAR << 10) & 0xC00) | tex->control_words[0] & 0xFFFFF3FF;
+	}
 }
 static inline __attribute__((always_inline)) void vglSetTexLodBias(SceGxmTexture *texture, uint32_t bias) {
 	SceGxmTextureInternal *tex = (SceGxmTextureInternal *)texture;
diff --git a/source/vitaGL.h b/source/vitaGL.h
index 2359078..e158cd4 100644
--- a/source/vitaGL.h
+++ b/source/vitaGL.h
@@ -1324,6 +1324,7 @@ GLboolean vglSwapResolution(int width, int height);
 
 // Loads the depth buffer of the currently bound renderbuffer into the currently bound GL texture.
 void vglTexImageDepthBuffer(GLenum target);
+int vglStrikersBindFramebufferDepth(GLuint fb_id); // Strikers 1.1: a framebuffer's depth buffer as the bound texture (returns its row width, 0: none yet)
 
 // Makes vitaGL use cached memory instead of uncached memory for its internal memory pools. Must be called before vglInit*.
 void vglUseCachedMem(GLboolean use);
@@ -1418,6 +1419,9 @@ typedef struct {
 	vglRtGpuFrame gpu_frames[128];
 } vglRtStats;
 void vglRtGetStats(vglRtStats *s);
+uint32_t vglRtLastGpuFrame(vglRtGpuFrame *out);
+void vglRtSceneProgress(uint32_t *submitted, uint32_t *done); // scenes ended / seen completed by the GPU watcher (GPU timers on; else 0 / 0)
+void vglSetAnisotropicFilter(uint32_t sceFilter); // 0 off; 2 or 3: the minification filter of trilinear textures (see utils/gxm_utils.h) // the newest finished GPU frame; returns frames finished so far (0: none)
 
 #ifdef __cplusplus
 }
