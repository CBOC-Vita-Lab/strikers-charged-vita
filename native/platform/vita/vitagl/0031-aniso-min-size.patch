From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: CBOC-Vita <cboc-vita@users.noreply.github.com>
Date: Tue, 10 Nov 2026 12:00:00 -0500
Subject: [PATCH] Anisotropic filter: textures under a size keep trilinear (vglSetAnisotropicMinSize)

---

diff --git a/source/rt.c b/source/rt.c
index 4b3eef1..4628020 100644
--- a/source/rt.c
+++ b/source/rt.c
@@ -31,6 +31,8 @@
 uint32_t vgl_rt_flags = 0;
 uint32_t vgl_aniso_min = 0; // utils/gxm_utils.h vglSetTexMinFilter
 void vglSetAnisotropicFilter(uint32_t sceFilter) { vgl_aniso_min = (sceFilter == 2 || sceFilter == 3) ? sceFilter : 0; }
+uint32_t vgl_aniso_minpx = 0; // utils/gxm_utils.h vglAnisoSizeOk (Strikers 1.3, 0028)
+void vglSetAnisotropicMinSize(uint32_t texels) { vgl_aniso_minpx = texels; }
 GLuint vgl_rt_hint_fb = 0;
 uint32_t vgl_rt_hint = 0;
 GLboolean vgl_rt_hint_valid = GL_FALSE;
diff --git a/source/utils/gxm_utils.h b/source/utils/gxm_utils.h
index a440347..dab7f28 100644
--- a/source/utils/gxm_utils.h
+++ b/source/utils/gxm_utils.h
@@ -113,9 +113,19 @@ static inline __attribute__((always_inline)) void vglSetTexVMode(SceGxmTexture *
 // minification filter instead (2 or 3: the filter values vitasdk names MIPMAP_LINEAR / MIPMAP_POINT, believed to be the hardware's
 // anisotropic modes; 0: off, the default)
 extern uint32_t vgl_aniso_min;
+// (Strikers 1.3, 0028) vgl_aniso_minpx: a texture whose larger side is below this many texels keeps plain trilinear filtering (0: every trilinear texture is anisotropic, as before).
+// Judged when the filter is set, from the texture's own size words: no cost per draw.
+extern uint32_t vgl_aniso_minpx;
+static inline __attribute__((always_inline)) int vglAnisoSizeOk(SceGxmTexture *texture) {
+	if (!vgl_aniso_minpx)
+		return 1;
+	uint32_t w, h;
+	vglGetTexSizes(texture, &w, &h);
+	return (w > h ? w : h) >= vgl_aniso_minpx;
+}
 static inline __attribute__((always_inline)) void vglSetTexMinFilter(SceGxmTexture *texture, SceGxmTextureFilter minFilter) {
 	SceGxmTextureInternal *tex = (SceGxmTextureInternal *)texture;
-	if (vgl_aniso_min && minFilter == SCE_GXM_TEXTURE_FILTER_LINEAR && (tex->control_words[0] & 0x200))
+	if (vgl_aniso_min && minFilter == SCE_GXM_TEXTURE_FILTER_LINEAR && (tex->control_words[0] & 0x200) && vglAnisoSizeOk(texture))
 		minFilter = (SceGxmTextureFilter)vgl_aniso_min;
 	tex->control_words[0] = ((minFilter << 10) & 0xC00) | tex->control_words[0] & 0xFFFFF3FF;
 }
@@ -128,7 +138,7 @@ static inline __attribute__((always_inline)) void vglSetTexMipFilter(SceGxmTextu
 	tex->control_words[0] = mipFilter & 0x200 | tex->control_words[0] & 0xFFFFFDFF;
 	if (vgl_aniso_min) { // (the order of the two calls varies: a LINEAR minification becomes anisotropic once the mip filter is on, and back)
 		const uint32_t minf = (tex->control_words[0] >> 10) & 3;
-		if ((mipFilter & 0x200) && minf == SCE_GXM_TEXTURE_FILTER_LINEAR)
+		if ((mipFilter & 0x200) && minf == SCE_GXM_TEXTURE_FILTER_LINEAR && vglAnisoSizeOk(texture))
 			tex->control_words[0] = ((vgl_aniso_min << 10) & 0xC00) | tex->control_words[0] & 0xFFFFF3FF;
 		else if (!(mipFilter & 0x200) && minf == vgl_aniso_min)
 			tex->control_words[0] = ((SCE_GXM_TEXTURE_FILTER_LINEAR << 10) & 0xC00) | tex->control_words[0] & 0xFFFFF3FF;
diff --git a/source/vitaGL.h b/source/vitaGL.h
index 943eaef..582f74e 100644
--- a/source/vitaGL.h
+++ b/source/vitaGL.h
@@ -1487,6 +1487,7 @@ uint32_t vglRobustFailures(uint32_t *scene_begins, uint32_t *shader_patches); //
 void vglRtSceneProgress(uint32_t *submitted, uint32_t *done); // scenes ended / seen completed by the GPU watcher (GPU timers on; else 0 / 0)
 int vglRtWaitScenesDone(uint32_t target, uint32_t timeout_us); // 0022: blocks until done reaches target (0), timeout (1), or -1: poll vglRtSceneProgress instead
 void vglSetAnisotropicFilter(uint32_t sceFilter); // 0 off; 2 or 3: the minification filter of trilinear textures (see utils/gxm_utils.h) // the newest finished GPU frame; returns frames finished so far (0: none)
+void vglSetAnisotropicMinSize(uint32_t texels); // Strikers 1.3 (0028): textures whose larger side is below this keep trilinear when the anisotropic filter is on (0: none excluded)
 
 #ifdef __cplusplus
 }
