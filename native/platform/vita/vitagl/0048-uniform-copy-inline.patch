From: CBOC-Vita <cboc-vita@users.noreply.github.com>
Subject: [PATCH] 1.3: vgl_uniform_copy inline fast paths for 8/16 bytes (upstream Rinnegatamante/vitaGL 53cc00f)

Exact backport: same bytes copied, the noinline size switch is replaced by direct 8/16 byte copies and an inline small-size switch. Requires 0047 context. No option, no shader compilation change.

diff --git a/source/utils/gxm_utils.c b/source/utils/gxm_utils.c
index dc0e4a8..b667a6f 100644
--- a/source/utils/gxm_utils.c
+++ b/source/utils/gxm_utils.c
@@ -281,48 +281,40 @@ void *vglReserveUniformCircularPoolBuffer(uint32_t size) {
 		dst += align_size; \
 	}
 
-// Allowing for fast load/store on small copies where this would be faster than sceClibMemcpy
-static __attribute__((noinline)) void vgl_fast_uniform_copy(void *dst, const void *src, size_t size) {
-	switch (size) {
-	case 1:
-		__builtin_memcpy(dst, src, 1);
-		break;
-	case 2:
-		__builtin_memcpy(dst, src, 2);
-		break;
-	case 3:
-		__builtin_memcpy(dst, src, 3);
-		break;
-	case 4:
-		__builtin_memcpy(dst, src, 4);
-		break;
-	case 6:
-		__builtin_memcpy(dst, src, 6);
-		break;
-	case 8:
+// Keep common vec2/vec4 copies as direct fast paths, then inline other small sizes.
+static inline __attribute__((always_inline)) void vgl_uniform_copy(void *dst, const void *src, size_t size) {
+	if (size == 8) {
 		__builtin_memcpy(dst, src, 8);
-		break;
-	case 12:
-		__builtin_memcpy(dst, src, 12);
-		break;
-	case 16:
+	} else if (size == 16) {
 		__builtin_memcpy(dst, src, 16);
-		break;
-	case 24:
+	} else if (size <= 16) {
+		switch (size) {
+		case 1:
+			__builtin_memcpy(dst, src, 1);
+			break;
+		case 2:
+			__builtin_memcpy(dst, src, 2);
+			break;
+		case 3:
+			__builtin_memcpy(dst, src, 3);
+			break;
+		case 4:
+			__builtin_memcpy(dst, src, 4);
+			break;
+		case 6:
+			__builtin_memcpy(dst, src, 6);
+			break;
+		case 12:
+			__builtin_memcpy(dst, src, 12);
+			break;
+		default:
+			vgl_fast_memcpy(dst, src, size);
+			break;
+		}
+	} else if (size == 24) {
 		__builtin_memcpy(dst, src, 24);
-		break;
-	case 48:
+	} else if (size == 48) {
 		__builtin_memcpy(dst, src, 48);
-		break;
-	default:
-		vgl_fast_memcpy(dst, src, size);
-		break;
-	}
-}
-
-static inline __attribute__((always_inline)) void vgl_uniform_copy(void *dst, const void *src, size_t size) {
-	if (size <= 16 || size == 24 || size == 48) {
-		vgl_fast_uniform_copy(dst, src, size);
 	} else {
 		vgl_fast_memcpy(dst, src, size);
 	}
