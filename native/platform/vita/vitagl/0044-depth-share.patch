diff --git a/source/utils/depth_share_core.h b/source/utils/depth_share_core.h
new file mode 100644
index 00000000..3576d82c
--- /dev/null
+++ b/source/utils/depth_share_core.h
@@ -0,0 +1,83 @@
+/* 0044 (MSC_VGX_LADDER_ALIAS): the bookkeeping of the shared depth blocks, with no GXM and no allocator in it so that a host test (renderer/tests/depthshare.cpp)
+ * runs the very code the console runs. mem_utils.c holds the table, the memory and the surface copies.
+ *
+ * A block is made for a (multisample mode, capacity w x h) the first time an object asks for it and is freed with its last user. refs counts the users;
+ * last_fb is the user whose scene began last, to see a change of user: it is the identity of the drawing context and is valid only between two changes of
+ * the users (A2: framebuffer objects are slots of a static array, a deleted object's slot is reused by a new one of another size, and an object that is
+ * resized gives up its depth and joins again; "the same address as last time" must not be read as "the same context"). So every join and every leave clears it. */
+#ifndef VGL_DEPTH_SHARE_CORE_H
+#define VGL_DEPTH_SHARE_CORE_H
+
+#define VGL_DSHARE_MAX 8
+
+typedef struct {
+	void *mem; /* the block (NULL: free slot) */
+	int refs; /* objects whose depth surface lives in it */
+	const void *last_fb; /* the object whose scene began last (NULL: none since the last join or leave) */
+	int mode; /* the multisample mode, as the caller numbers it */
+	int cw, ch; /* the capacity: the stride is cw samples, ch rows */
+} vgl_dshare_rec;
+
+typedef struct {
+	vgl_dshare_rec rec[VGL_DSHARE_MAX];
+	unsigned made, joined, failed;
+} vgl_dshare_tbl;
+
+static inline int vgl_ds_find(const vgl_dshare_tbl *t, int mode, int cw, int ch) {
+	for (int i = 0; i < VGL_DSHARE_MAX; i++)
+		if (t->rec[i].mem && t->rec[i].mode == mode && t->rec[i].cw == cw && t->rec[i].ch == ch)
+			return i;
+	return -1;
+}
+static inline int vgl_ds_free_slot(const vgl_dshare_tbl *t) {
+	for (int i = 0; i < VGL_DSHARE_MAX; i++)
+		if (!t->rec[i].mem)
+			return i;
+	return -1;
+}
+/* a new block in slot i (no users yet) */
+static inline void vgl_ds_add(vgl_dshare_tbl *t, int i, void *mem, int mode, int cw, int ch) {
+	t->rec[i].mem = mem;
+	t->rec[i].refs = 0;
+	t->rec[i].last_fb = 0;
+	t->rec[i].mode = mode;
+	t->rec[i].cw = cw;
+	t->rec[i].ch = ch;
+	t->made++;
+}
+/* an object joins the block of slot i */
+static inline void vgl_ds_join(vgl_dshare_tbl *t, int i) {
+	t->rec[i].refs++;
+	t->rec[i].last_fb = 0; /* A2 */
+	t->joined++;
+}
+/* a depth surface at `mem` is released. 1: it was the last user of a shared block (the slot is free again; the caller frees the memory); 0: other users remain;
+ * -1: not a shared block (the caller frees it as before) */
+static inline int vgl_ds_release(vgl_dshare_tbl *t, const void *mem) {
+	for (int i = 0; i < VGL_DSHARE_MAX; i++) {
+		if (t->rec[i].mem && t->rec[i].mem == mem) {
+			t->rec[i].last_fb = 0; /* A2 */
+			if (--t->rec[i].refs > 0)
+				return 0;
+			t->rec[i].mem = 0;
+			t->rec[i].refs = 0;
+			return 1;
+		}
+	}
+	return -1;
+}
+/* a scene of object `fb` begins on `mem`. 1: another context drew in the block last (or none is known): what is recorded about the content (the mask-keep record) is not the new
+ * scene's; 0: the same context as last time, or not a shared block */
+static inline int vgl_ds_scene(vgl_dshare_tbl *t, const void *mem, const void *fb) {
+	for (int i = 0; i < VGL_DSHARE_MAX; i++) {
+		if (t->rec[i].mem && t->rec[i].mem == mem) {
+			if (t->rec[i].last_fb != fb) {
+				t->rec[i].last_fb = fb;
+				return 1;
+			}
+			return 0;
+		}
+	}
+	return 0;
+}
+#endif
diff --git a/source/utils/mem_utils.c b/source/utils/mem_utils.c
index 83177548..3a0f9794 100644
--- a/source/utils/mem_utils.c
+++ b/source/utils/mem_utils.c
@@ -1351,3 +1351,56 @@ void *vgl_realloc(void *ptr, size_t size) {
 	return res;
 }
 /* MEMSITES END */
+
+/* 0044: depth surface blocks shared by framebuffer objects (vglFramebufferDepthShare). The bookkeeping is depth_share_core.h (host-tested); here are the memory and the surface
+ * copies. vgl_depth_release is what mark_depth_stencil_as_dirty calls for every depth block: a shared block goes to the collector with its last user. */
+#include "depth_share_core.h"
+static vgl_dshare_tbl vgl_dshare;
+static SceGxmDepthStencilSurface vgl_dshare_surf[VGL_DSHARE_MAX];
+
+void vgl_depth_release(void *p) {
+	if (vgl_ds_release(&vgl_dshare, p) == 0)
+		return; // other users remain
+	mark_as_dirty(p);
+}
+
+GLboolean vgl_depth_share_get(int cw, int ch, SceGxmMultisampleMode mode, SceGxmDepthStencilSurface *out, const void *fb) {
+	int i = vgl_ds_find(&vgl_dshare, (int)mode, cw, ch);
+	if (i < 0) {
+		i = vgl_ds_free_slot(&vgl_dshare);
+		if (i < 0) {
+			vgl_dshare.failed++;
+			return GL_FALSE;
+		}
+		SceGxmDepthStencilSurface s;
+		vgl_memset(&s, 0, sizeof(s));
+		if (!init_depth_stencil_buffer_ms(cw, ch, &s, GL_FALSE, mode) || !s.depthData) {
+			vgl_dshare.failed++;
+			return GL_FALSE;
+		}
+		vgl_ds_add(&vgl_dshare, i, s.depthData, (int)mode, cw, ch);
+		vgl_dshare_surf[i] = s;
+		vgl_log("%s:%d 0044 depth block %dx%d (mode %d) made\n", __FILE__, __LINE__, cw, ch, (int)mode);
+	}
+	*out = vgl_dshare_surf[i];
+	vgl_ds_join(&vgl_dshare, i);
+	return GL_TRUE;
+}
+
+// A scene begins on a shared block: if another object drew in it last, what the mask-keep record knows of its content is not the new picture's (the memory is the same, the size is not)
+void vgl_depth_share_scene(const void *mem, const void *fb) {
+	if (vgl_ds_scene(&vgl_dshare, mem, fb))
+		vgl_mk_forget(mem);
+}
+
+// Counters for the front end: blocks made, objects joined, joins refused (no slot or no memory), blocks live now
+void vglDepthShareStats(uint32_t *out4) {
+	uint32_t live = 0;
+	for (int i = 0; i < VGL_DSHARE_MAX; i++)
+		if (vgl_dshare.rec[i].mem)
+			live++;
+	out4[0] = vgl_dshare.made;
+	out4[1] = vgl_dshare.joined;
+	out4[2] = vgl_dshare.failed;
+	out4[3] = live;
+}
