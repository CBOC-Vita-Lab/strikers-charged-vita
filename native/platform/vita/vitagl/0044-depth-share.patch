-			mark_as_dirty((s)->depthData); \
+			vgl_depth_release((s)->depthData); /* 0044: a shared block goes with its last user */ \
 		} \
 		if ((s)->stencilData) { \
 			mark_as_dirty((s)->stencilData); \
