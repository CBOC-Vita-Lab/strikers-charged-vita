From: CBOC-Vita <cboc-vita@users.noreply.github.com>
Subject: [PATCH] 1.3: vglRtSetSplit: a vertex notification per scene, GPU busy time after tiling

MSC_VITA_RT_SPLIT, off unless asked for. Off, the scene is ended as before.


diff --git a/source/rt.c b/source/rt.c
index f1df4e0..11af332 100644
--- a/source/rt.c
+++ b/source/rt.c
@@ -66,6 +66,8 @@ static volatile uint32_t rt_produced = 0; // scenes recorded
 static volatile uint32_t rt_consumed = 0; // scenes the watcher has finished with
 static volatile uint32_t rt_watcher_idle = 0;
 static volatile unsigned int *rt_slots = NULL;
+static volatile unsigned int *rt_vslots = NULL; // 0021 vglRtSetSplit: each scene's vertex notification, the words after rt_slots
+static GLboolean rt_split = GL_FALSE;
 static SceUID rt_sema = -1, rt_thread = -1;
 static uint32_t rt_frame = 0; // render thread: frames (vglSwapBuffers) so far
 static vglRtGpuFrame rt_gpu_frames[RT_FRAMES];
@@ -182,7 +184,15 @@ void vgl_rt_end_scene(SceGxmContext *ctx) {
 		n.address = &rt_slots[seq % RT_SLOTS];
 		n.value = seq + 1;
 		*n.address = 0;
-		sceGxmEndScene(ctx, NULL, &n);
+		if (rt_vslots) {
+			SceGxmNotification v;
+			v.address = &rt_vslots[seq % RT_SLOTS];
+			v.value = seq + 1;
+			*v.address = 0;
+			sceGxmEndScene(ctx, &v, &n);
+		} else {
+			sceGxmEndScene(ctx, NULL, &n);
+		}
 		r->timed = 1;
 	} else {
 		sceGxmEndScene(ctx, NULL, &query_fence);
@@ -213,7 +223,7 @@ void vgl_rt_frame_end(void) {
 }
 
 static int rt_watcher(SceSize args, void *argp) {
-	uint32_t cur = 0xFFFFFFFF, first_submit = 0, last_submit = 0, last_done = 0, prev_done = 0, busy = 0, scenes = 0, timed = 0;
+	uint32_t cur = 0xFFFFFFFF, first_submit = 0, last_submit = 0, last_done = 0, prev_done = 0, busy = 0, scenes = 0, timed = 0, pixel = 0, tiling = 0;
 	GLboolean have_prev = GL_FALSE;
 	for (;;) {
 		uint32_t produced = rt_produced;
@@ -233,6 +243,8 @@ static int rt_watcher(SceSize args, void *argp) {
 			if (cur != 0xFFFFFFFF && scenes) {
 				vglRtGpuFrame *f = &rt_gpu_frames[rt_gpu_frame_head % RT_FRAMES];
 				f->busy_us = busy;
+				f->pixel_us = pixel;
+				f->tiling_us = tiling;
 				f->span_us = timed ? last_done - first_submit : 0;
 				f->tail_us = timed ? last_done - last_submit : 0;
 				f->scenes = scenes;
@@ -243,12 +255,20 @@ static int rt_watcher(SceSize args, void *argp) {
 			}
 			cur = r->frame;
 			first_submit = r->submit_us;
-			busy = scenes = timed = 0;
+			busy = scenes = timed = pixel = tiling = 0;
 		}
 		scenes++;
 		last_submit = r->submit_us;
 		if (r->timed) {
 			SceGxmNotification n;
+			uint32_t vdone = 0;
+			if (rt_vslots) { // 0021: pixels cannot start before the scene's tiling is done or the scene before has finished
+				n.address = &rt_vslots[seq % RT_SLOTS];
+				n.value = seq + 1;
+				if (*n.address != n.value)
+					sceGxmNotificationWait(&n);
+				vdone = rt_now();
+			}
 			n.address = &rt_slots[seq % RT_SLOTS];
 			n.value = seq + 1;
 			if (*n.address != n.value) {
@@ -263,6 +283,13 @@ static int rt_watcher(SceSize args, void *argp) {
 				start = prev_done;
 			if ((int32_t)(done - start) > 0)
 				busy += done - start;
+			if (rt_vslots) {
+				uint32_t pstart = (int32_t)(vdone - start) > 0 ? vdone : start;
+				if ((int32_t)(done - pstart) > 0)
+					pixel += done - pstart;
+				if ((int32_t)(vdone - r->submit_us) > 0)
+					tiling += vdone - r->submit_us;
+			}
 			prev_done = done;
 			have_prev = GL_TRUE;
 			last_done = done;
@@ -277,6 +304,8 @@ static int rt_watcher(SceSize args, void *argp) {
 	return 0;
 }
 
+void vglRtSetSplit(uint32_t enabled) { rt_split = enabled ? GL_TRUE : GL_FALSE; } // (default off; before vglRtSetup)
+
 void vglRtSetup(uint32_t flags, int watcher_priority, int watcher_affinity) {
 	vgl_rt_flags = flags;
 	if (flags & VGL_RT_CPU_TIMERS) {
@@ -291,6 +320,11 @@ void vglRtSetup(uint32_t flags, int watcher_priority, int watcher_affinity) {
 		rt_slots = (volatile unsigned int *)sceGxmGetNotificationRegion() + 1;
 		for (int i = 0; i < RT_SLOTS; i++)
 			rt_slots[i] = 0;
+		if (rt_split) {
+			rt_vslots = rt_slots + RT_SLOTS;
+			for (int i = 0; i < RT_SLOTS; i++)
+				rt_vslots[i] = 0;
+		}
 		rt_sema = sceKernelCreateSema("vgl_rt_sema", 0, 0, 0x7FFFFFFF, NULL);
 		rt_thread = sceKernelCreateThread("vgl_rt_gpu", rt_watcher, watcher_priority ? watcher_priority : 0x10000100, 0x2000, 0, watcher_affinity, NULL);
 		if (rt_sema < 0 || rt_thread < 0 || sceKernelStartThread(rt_thread, 0, NULL) < 0) {
diff --git a/source/vitaGL.h b/source/vitaGL.h
index 4e68be5..df600ce 100644
--- a/source/vitaGL.h
+++ b/source/vitaGL.h
@@ -1452,7 +1452,9 @@ typedef struct {
 typedef struct {
 	uint32_t busy_us, span_us, tail_us; // see rt.c: GPU busy time, first submission to last completion, last submission to last completion
 	uint16_t scenes, timed;
+	uint32_t pixel_us, tiling_us; // 0021 vglRtSetSplit: the part of busy_us after each scene's tiling ended; tiling seen after submission (a lower bound: scenes overlap)
 } vglRtGpuFrame;
+void vglRtSetSplit(uint32_t enabled);
 typedef struct {
 	uint32_t version, flags;
 	uint32_t scenes, scenes_display, scenes_noload, scenes_noload_auto, scenes_nostore, hints_given, hints_used;
