From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: CBOC-Vita <cboc-vita@users.noreply.github.com>
Date: Tue, 24 Nov 2026 12:00:00 -0500
Subject: [PATCH] anisotropic filter per texture (vglTexAnisoOff; MSC_VITA_ANISO_SCOPE) and tiled render-target colour surfaces (vglSetTiledTargets, vglTexMakeTiledTarget; MSC_VGX_TILED_RT), both off

---

diff --git a/source/framebuffers.c b/source/framebuffers.c
index 46276b9c8..a0351cbca 100644
--- a/source/framebuffers.c
+++ b/source/framebuffers.c
@@ -594,6 +594,12 @@ void glGetFramebufferAttachmentParameteriv(GLenum target, GLenum attachment, GLe
 void glReadPixels(GLint x, GLint y, GLsizei width, GLsizei height, GLenum format, GLenum type, GLvoid *data) {
 	THREAD_SAFE()
 
+	// 0057: the CPU reads linear rows; a tiled colour surface (vglTexMakeTiledTarget) is not one: nothing is read
+	if (active_read_fb && active_read_fb->tex && sceGxmTextureGetType(&active_read_fb->tex->gxm_tex) == SCE_GXM_TEXTURE_TILED) {
+		vgl_tiled_read_refused++;
+		return;
+	}
+
 	/*
 	 * Callbacks are actually used to just perform down/up-sampling
 	 * between U8 texture formats. Reads are expected to give as result
@@ -812,6 +818,11 @@ void glReadPixels(GLint x, GLint y, GLsizei width, GLsizei height, GLenum format
 void vglReadPixels(GLint x, GLint y, GLsizei width, GLsizei height, GLenum format, GLenum type, GLvoid *data) {
 	THREAD_SAFE()
 
+	if (active_read_fb && active_read_fb->tex && sceGxmTextureGetType(&active_read_fb->tex->gxm_tex) == SCE_GXM_TEXTURE_TILED) { // 0057
+		vgl_tiled_read_refused++;
+		return;
+	}
+
 	GLboolean res = _glReadPixels_gpu(x, y, width, height, format, type, data, GL_TRUE);
 #ifndef SKIP_ERROR_HANDLING
 	if (!res) {
diff --git a/source/shared.h b/source/shared.h
