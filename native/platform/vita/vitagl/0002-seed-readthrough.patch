From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: CBOC-Vita <cboc-vita@users.noreply.github.com>
Date: Fri, 30 Oct 2026 08:41:10 -0400
Subject: [PATCH] Seed read-through: read the package's compiled shaders in place

---
 source/custom_shaders.c | 25 +++++++++++++++++++++++++
 source/vgl.c            | 14 ++++++++++++++
 source/vitaGL.h         |  1 +
 3 files changed, 40 insertions(+)

diff --git a/source/custom_shaders.c b/source/custom_shaders.c
index c7a1c47..2403c2b 100644
--- a/source/custom_shaders.c
+++ b/source/custom_shaders.c
@@ -35,6 +35,25 @@
 #include "utils/xxhash_utils.h"
 #ifdef HAVE_SHADER_CACHE
 char vgl_shader_cache_path[256];
+#ifdef HAVE_SHADER_CACHE
+// W5 SEED: a second, READ-ONLY cache folder (the package's seed: app0:shadercache/<key>/v<magic>), tried when the writable cache has no file for a shader.
+// With it a package can carry every compiled shader without copying them to the memory card at the first start (about 75 ms per file or folder there).
+char vgl_shader_seed_path[256];
+static SceUID vgl_open_seed(const char *kind, uint8_t subdir_hash, uint64_t hash) {
+	if (!vgl_shader_seed_path[0])
+		return -1;
+	char fname[256];
+	// The names this library's own cache writes (16 hex digits, upstream since cache version 3) first; a seed taken from an older
+	// library names its files without the leading zeros: tried second, and only when that spelling is a different one.
+	sprintf(fname, "%s/%s/%02X/%016llX.gxp", vgl_shader_seed_path, kind, subdir_hash, hash);
+	SceUID f = sceIoOpen(fname, SCE_O_RDONLY, 0777);
+	if (f < 0 && (hash >> 60) == 0) {
+		sprintf(fname, "%s/%s/%02X/%llX.gxp", vgl_shader_seed_path, kind, subdir_hash, hash);
+		f = sceIoOpen(fname, SCE_O_RDONLY, 0777);
+	}
+	return f;
+}
+#endif
 #endif
 #ifdef HAVE_TEX_CACHE
 char vgl_file_cache_path[256];
@@ -2014,6 +2033,8 @@ void glCompileShader(GLuint handle) {
 	uint8_t subdir_hash = hash >> 56;
 	int fname_len = sprintf(fname, "%s/%s/%02X/%016llX.gxp", vgl_shader_cache_path, s->type == GL_VERTEX_SHADER ? "v" : "f", subdir_hash, hash);
 	SceUID f = sceIoOpen(fname, SCE_O_RDONLY, 0777);
+	if (f < 0)
+		f = vgl_open_seed(s->type == GL_VERTEX_SHADER ? "v" : "f", subdir_hash, hash);
 	if (f >= 0) {
 		vgl_free(s->source);
 		s->source = NULL;
@@ -2416,6 +2437,8 @@ void glLinkProgram(GLuint progr) {
 			uint8_t subdir_hash = hash >> 56;
 			fname_len = sprintf(vert_fname, "%s/v/%02X/%016llX.gxp", vgl_shader_cache_path, subdir_hash, hash);
 			SceUID f = sceIoOpen(vert_fname, SCE_O_RDONLY, 0777);
+			if (f < 0)
+				f = vgl_open_seed("v", subdir_hash, hash);
 			if (f >= 0) {
 				size_t sz = sceIoLseek(f, 0, SCE_SEEK_END);
 				sceIoLseek(f, 0, SCE_SEEK_SET);
@@ -2431,6 +2454,8 @@ void glLinkProgram(GLuint progr) {
 			uint8_t subdir_hash = hash >> 56;
 			fname_len = sprintf(frag_fname, "%s/f/%02X/%016llX.gxp", vgl_shader_cache_path, subdir_hash, hash);
 			SceUID f = sceIoOpen(frag_fname, SCE_O_RDONLY, 0777);
+			if (f < 0)
+				f = vgl_open_seed("f", subdir_hash, hash);
 			if (f >= 0) {
 				size_t sz = sceIoLseek(f, 0, SCE_SEEK_END);
 				sceIoLseek(f, 0, SCE_SEEK_SET);
diff --git a/source/vgl.c b/source/vgl.c
index 22d8fa2..3019226 100644
--- a/source/vgl.c
+++ b/source/vgl.c
@@ -975,6 +975,20 @@ void vglSetShaderCachePath(const char *path) {
 #endif
 }
 
+#ifdef HAVE_SHADER_CACHE
+extern char vgl_shader_seed_path[256];
+#endif
+// W5 SEED: the read-only second cache folder (see custom_shaders.c); "" or NULL = none
+void vglSetShaderSeedPath(const char *path) {
+#ifdef HAVE_SHADER_CACHE
+	if (path) {
+		strncpy(vgl_shader_seed_path, path, sizeof(vgl_shader_seed_path) - 1);
+		vgl_shader_seed_path[sizeof(vgl_shader_seed_path) - 1] = 0;
+	} else
+		vgl_shader_seed_path[0] = 0;
+#endif
+}
+
 void vglSetShaderAssociationPath(const char *path) {
 	shark_set_shader_association_path(path);
 }
diff --git a/source/vitaGL.h b/source/vitaGL.h
index 73656d8..a4e5274 100644
--- a/source/vitaGL.h
+++ b/source/vitaGL.h
@@ -1277,6 +1277,7 @@ void vglSetShaderAssociationPath(const char *path);
 
 // Overloads the shader cache path when HAVE_SHADER_CACHE=1 is used. Must be called before vglInit*. Default value: ux0:data/shader_cache.
 void vglSetShaderCachePath(const char *path);
+void vglSetShaderSeedPath(const char *path); // W5 SEED: read-only second shader cache folder (<path>/{v,f}/HH/hash.gxp), tried when the first has no file
 
 // Overloads the default vitaGL boot splashscreen with a custom one. Not compatible with NO_SPLASHSCREEN=1.
 void vglSetupCustomSplashscreen(vglSplashCallback init_callback, vglSplashCallback term_callback, vglSplashCallback main_callback, GLboolean clear_screen);
