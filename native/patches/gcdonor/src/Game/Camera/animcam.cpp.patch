+// NP: camera files and the camera chunks inside .nis files are big-endian. Converts the headers of
+// the camera container `camera` (a 0x8002500B chunk of `size` bytes, header included) and the
+// payloads LoadAnimCameraData reads: the key count (u32) and the position, target, rotation, FOV and
+// focal length key arrays (floats). Returns false, converting nothing further, when the tree is not
+// well formed; the loader must then not walk it.
+bool PortConvertCameraChunk(nlChunk* camera, unsigned long size)
+{
+    if (port_disc_chunk_swap_tree(camera, size) == 0)
+    {
+        return false;
+    }
+
+    nlChunk* end = camera->GetLastChunk();
+    for (nlChunk* chunk = camera->GetFirstChunk(); chunk < end; chunk = chunk->GetNextChunk())
+    {
+        switch (chunk->GetID())
+        {
+        case 0x2500C:
+        case 0x25003:
+        case 0x25004:
+        case 0x25006:
+        case 0x25009:
+        case 0x2500A:
+            port_disc32_array(chunk->GetData(), chunk->GetDataSize() / 4);
+            break;
+        default:
+            break;
+        }
+    }
+    return true;
+}
