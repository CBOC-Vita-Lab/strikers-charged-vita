+        float largestWeight = 0.0f;
+        int largestIndex = 0;
+        float w[4];
+        int k;
+        for (k = 0; k < 4; ++k)
+            w[k] = npa_rdf32(boneWeights + 4 * k);
+        for (k = 0; k < 4; ++k)
+        {
+            if (w[k] > largestWeight)
+            {
+                largestIndex = k;
+                largestWeight = w[k];
+            }
+        }
+
+        if (largestIndex != 0)
+        {
+            unsigned char firstIndex = boneIndices[0];
+            unsigned char firstWeight[4];
+            memcpy(firstWeight, boneWeights, 4);
+            boneIndices[0] = boneIndices[largestIndex];
+            memcpy(boneWeights, boneWeights + 4 * largestIndex, 4);
+            boneIndices[largestIndex] = firstIndex;
+            memcpy(boneWeights + 4 * largestIndex, firstWeight, 4);
+        }
+
+        boneIndices += 4;
+        boneWeights += 16;
+    }
+}
